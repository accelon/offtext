{
  "name": "offtext",
  "version": "0.2.0",
  "private": true,
  "description": "巢式文字 Offtext：以 CodeMirror 6 編輯與閱讀同一份巢狀文字。",
  "scripts": {
    "build:lib": "node src/tools/build-lib.mjs",
    "build:app": "node src/tools/build-app.mjs",
    "build:editor": "node src/tools/build-editor.mjs",
    "build:web": "node src/tools/build.mjs",
    "typecheck": "tsc -p tsconfig.json",
    "build": "node src/tools/build-all.mjs",
    "desktop:assets": "node desktop/scripts/sync-assets.mjs",
    "desktop:build": "node desktop/scripts/build-desktop.mjs",
    "desktop:selftest": "node desktop/scripts/selftest.mjs",
    "desktop:smoke": "node desktop/tests/smoke-cdp.mjs",
    "serve": "node src/tools/serve.mjs",
    "test:core": "node src/tools/test-core.mjs",
    "test:editor": "node src/tools/cm-test.mjs",
    "test:boot": "node src/tools/boot-test.mjs",
    "test:hover": "node src/tools/hover-test.mjs",
    "test:intext": "node src/tools/intext-test.mjs",
    "test:mobile": "node src/tools/mobile-test.mjs",
    "test:tour": "node src/tools/tour-test.mjs",
    "test:export": "node src/tools/export-test.mjs",
    "test:save": "node src/tools/save-test.mjs",
    "test:contrast": "node src/tools/contrast-test.mjs",
    "test:topbar": "node src/tools/topbar-test.mjs --width=1100",
    "audit:knowledge": "node src/tools/knowledge-audit.mjs",
    "audit:mentions": "node src/tools/mention-audit.mjs"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.18.6",
    "@codemirror/commands": "^6.8.1",
    "@codemirror/language": "^6.11.0",
    "@codemirror/state": "^6.5.2",
    "@codemirror/view": "^6.43.14"
  },
  "devDependencies": {
    "esbuild": "^0.25.0",
    "typescript": "^5.9.3"
  }
}
