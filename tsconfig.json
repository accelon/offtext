{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "allowImportingTsExtensions": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": [],
    "strict": false,
    "noImplicitAny": false,
    "noEmit": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false
  },
  "include": [
    "src/types/**/*.d.ts",
    "src/.tmp/offtext-app.typecheck.ts",
    "src/nestedtext-core.ts",
    "src/nestedtext-settings.ts",
    "src/nestedtext-simplified.ts",
    "src/editor/**/*.ts"
  ],
  "exclude": ["node_modules", "build", "desktop"]
}
